{
  "entities": {
    "UserAccount": {
      "title": "UserAccount",
      "description": "User shop login accounts",
      "type": "object",
      "properties": {
        "id": { "type": "string" },
        "shopName": { "type": "string" },
        "ownerName": { "type": "string" },
        "email": { "type": "string" },
        "phone": { "type": "string" },
        "passwordHash": { "type": "string" },
        "createdAt": { "type": "string" },
        "lastLoginAt": { "type": "string" }
      },
      "required": ["id", "email"]
    },
    "ServiceOrder": {
      "title": "ServiceOrder",
      "description": "Technical assistance service order entity",
      "type": "object",
      "properties": {
        "id": { "type": "string" },
        "orderNumber": { "type": "number" },
        "customerName": { "type": "string" },
        "deviceModel": { "type": "string" },
        "status": { "type": "string" },
        "totalAmount": { "type": "number" },
        "createdAt": { "type": "string" }
      },
      "required": ["id", "status"]
    },
    "Employee": {
      "title": "Employee",
      "description": "Store employee or collaborator",
      "type": "object",
      "properties": {
        "id": { "type": "string" },
        "name": { "type": "string" },
        "email": { "type": "string" },
        "role": { "type": "string" },
        "active": { "type": "boolean" }
      },
      "required": ["id", "name", "role"]
    },
    "Supplier": {
      "title": "Supplier",
      "description": "Component or parts supplier",
      "type": "object",
      "properties": {
        "id": { "type": "string" },
        "name": { "type": "string" },
        "phone": { "type": "string" }
      },
      "required": ["id", "name"]
    },
    "SupplierOrder": {
      "title": "SupplierOrder",
      "description": "Parts order group for suppliers",
      "type": "object",
      "properties": {
        "id": { "type": "string" },
        "title": { "type": "string" },
        "items": { "type": "array" }
      },
      "required": ["id", "title"]
    },
    "SupplierPurchase": {
      "title": "SupplierPurchase",
      "description": "Ordered parts tracked by supplier, payment and debt",
      "type": "object",
      "properties": {
        "purchaseId": { "type": "string" },
        "supplierName": { "type": "string" },
        "paymentStatus": { "type": "string" }
      },
      "required": ["purchaseId", "paymentStatus"]
    },
    "MonthlyDebit": {
      "title": "MonthlyDebit",
      "description": "Monthly debts or bills for tenant (Super Admin only)",
      "type": "object",
      "properties": {
        "id": { "type": "string" },
        "name": { "type": "string" },
        "totalAmount": { "type": "number" },
        "installmentsCount": { "type": "number" },
        "installmentAmount": { "type": "number" },
        "dueDate": { "type": "string" },
        "paidInstallments": { "type": "number" },
        "createdAt": { "type": "string" },
        "status": { "type": "string" },
        "payments": { "type": "array" }
      },
      "required": ["id", "name", "totalAmount"]
    },
    "AccountsPayable": {
      "title": "AccountsPayable",
      "description": "Day-to-day accounts payable ledger cards for tenant (Super Admin only)",
      "type": "object",
      "properties": {
        "id": { "type": "string" },
        "name": { "type": "string" },
        "currentBalance": { "type": "number" },
        "dueDate": { "type": "string" },
        "createdAt": { "type": "string" },
        "transactions": { "type": "array" }
      },
      "required": ["id", "name"]
    },
    "FinanceCashRegister": {
      "title": "FinanceCashRegister",
      "description": "Finance cash register cards for tenant",
      "type": "object",
      "properties": {
        "id": { "type": "string" },
        "name": { "type": "string" },
        "initialBalance": { "type": "number" },
        "currentBalance": { "type": "number" },
        "totalWithdrawn": { "type": "number" },
        "totalDeposited": { "type": "number" },
        "color": { "type": "string" },
        "notes": { "type": "string" },
        "createdAt": { "type": "string" },
        "updatedAt": { "type": "string" }
      },
      "required": ["id", "name"]
    },
    "FinanceCashMovement": {
      "title": "FinanceCashMovement",
      "description": "Cash movements (withdrawals, additions, payback) for cash registers",
      "type": "object",
      "properties": {
        "id": { "type": "string" },
        "cashRegisterId": { "type": "string" },
        "type": { "type": "string" },
        "amount": { "type": "number" },
        "reason": { "type": "string" },
        "date": { "type": "string" },
        "paidBackAmount": { "type": "number" },
        "isPaid": { "type": "boolean" }
      },
      "required": ["id", "cashRegisterId", "type", "amount", "reason"]
    },
    "DefinitiveExpense": {
      "title": "DefinitiveExpense",
      "description": "Definitive expenses deducted from a cash register",
      "type": "object",
      "properties": {
        "id": { "type": "string" },
        "cashRegisterId": { "type": "string" },
        "amount": { "type": "number" },
        "reason": { "type": "string" },
        "date": { "type": "string" }
      },
      "required": ["id", "cashRegisterId", "amount", "reason"]
    },
    "RealFixedCost": {
      "title": "RealFixedCost",
      "description": "Real fixed store costs (electricity, rent, water, etc.)",
      "type": "object",
      "properties": {
        "id": { "type": "string" },
        "name": { "type": "string" },
        "category": { "type": "string" },
        "amount": { "type": "number" },
        "dueDate": { "type": "string" },
        "isPaidThisMonth": { "type": "boolean" }
      },
      "required": ["id", "name", "category", "amount"]
    }
  },
  "firestore": {
    "/accounts/{accountId}": {
      "schema": "UserAccount",
      "description": "Tenant profile, settings and subscription record"
    },
    "/accounts/{accountId}/orders/{orderId}": {
      "schema": "ServiceOrder",
      "description": "Service orders for tenant"
    },
    "/accounts/{accountId}/employees/{employeeId}": {
      "schema": "Employee",
      "description": "Employees for tenant"
    },
    "/accounts/{accountId}/suppliers/{supplierId}": {
      "schema": "Supplier",
      "description": "Suppliers for tenant"
    },
    "/accounts/{accountId}/supplier_orders/{orderId}": {
      "schema": "SupplierOrder",
      "description": "Supplier order groups for tenant"
    },
    "/accounts/{accountId}/supplier_purchases/{purchaseId}": {
      "schema": "SupplierPurchase",
      "description": "Supplier purchases and parts debits for tenant"
    },
    "/accounts/{accountId}/monthly_debits/{debitId}": {
      "schema": "MonthlyDebit",
      "description": "Monthly bills and debits for tenant"
    },
    "/accounts/{accountId}/accounts_payable/{payableId}": {
      "schema": "AccountsPayable",
      "description": "Day-to-day accounts payable ledger cards for tenant"
    },
    "/accounts/{accountId}/finance_cash_registers/{registerId}": {
      "schema": "FinanceCashRegister",
      "description": "Cash register cards in finances"
    },
    "/accounts/{accountId}/finance_cash_movements/{movementId}": {
      "schema": "FinanceCashMovement",
      "description": "Cash movements and repayments in finances"
    },
    "/accounts/{accountId}/definitive_expenses/{expenseId}": {
      "schema": "DefinitiveExpense",
      "description": "Definitive expenses deducted from registers in finances"
    },
    "/accounts/{accountId}/real_fixed_costs/{costId}": {
      "schema": "RealFixedCost",
      "description": "Real fixed monthly costs"
    }
  }
}
