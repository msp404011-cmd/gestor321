{
  "entities": {
    "UserAccount": {
      "title": "UserAccount",
      "description": "User shop login accounts",
      "type": "object",
      "properties": {
        "id": { "type": "string" },
        "shopName": { "type": "string" },
        "ownerName": { "type": "string" },
        "email": { "type": "string" },
        "phone": { "type": "string" },
        "passwordHash": { "type": "string" },
        "createdAt": { "type": "string" },
        "lastLoginAt": { "type": "string" }
      },
      "required": ["id", "email"]
    },
    "ServiceOrder": {
      "title": "ServiceOrder",
      "description": "Technical assistance service order entity",
      "type": "object",
      "properties": {
        "id": { "type": "string" },
        "orderNumber": { "type": "number" },
        "customerName": { "type": "string" },
        "deviceModel": { "type": "string" },
        "status": { "type": "string" },
        "totalAmount": { "type": "number" },
        "createdAt": { "type": "string" }
      },
      "required": ["id", "status"]
    },
    "Employee": {
      "title": "Employee",
      "description": "Store employee or collaborator",
      "type": "object",
      "properties": {
        "id": { "type": "string" },
        "name": { "type": "string" },
        "email": { "type": "string" },
        "role": { "type": "string" },
        "active": { "type": "boolean" }
      },
      "required": ["id", "name", "role"]
    },
    "Supplier": {
      "title": "Supplier",
      "description": "Component or parts supplier",
      "type": "object",
      "properties": {
        "id": { "type": "string" },
        "name": { "type": "string" },
        "phone": { "type": "string" }
      },
      "required": ["id", "name"]
    },
    "SupplierOrder": {
      "title": "SupplierOrder",
      "description": "Parts order group for suppliers",
      "type": "object",
      "properties": {
        "id": { "type": "string" },
        "title": { "type": "string" },
        "items": { "type": "array" }
      },
      "required": ["id", "title"]
    },
    "SupplierPurchase": {
      "title": "SupplierPurchase",
      "description": "Ordered parts tracked by supplier, payment and debt",
      "type": "object",
      "properties": {
        "purchaseId": { "type": "string" },
        "supplierName": { "type": "string" },
        "paymentStatus": { "type": "string" }
      },
      "required": ["purchaseId", "paymentStatus"]
    }
  },
  "firestore": {
    "/accounts/{accountId}": {
      "schema": "UserAccount",
      "description": "Tenant profile, settings and subscription record"
    },
    "/accounts/{accountId}/orders/{orderId}": {
      "schema": "ServiceOrder",
      "description": "Service orders for tenant"
    },
    "/accounts/{accountId}/employees/{employeeId}": {
      "schema": "Employee",
      "description": "Employees for tenant"
    },
    "/accounts/{accountId}/suppliers/{supplierId}": {
      "schema": "Supplier",
      "description": "Suppliers for tenant"
    },
    "/accounts/{accountId}/supplier_orders/{orderId}": {
      "schema": "SupplierOrder",
      "description": "Supplier order groups for tenant"
    },
    "/accounts/{accountId}/supplier_purchases/{purchaseId}": {
      "schema": "SupplierPurchase",
      "description": "Supplier purchases and parts debits for tenant"
    }
  }
}
